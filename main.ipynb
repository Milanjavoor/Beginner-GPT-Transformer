import torch
import torch.nn as nn
import torch.nn.functional as F
torch.manual_seed(1333)
batch_size=64
block_size=128
max_tiers=2000
eval_inter=200
learning_rate=3e-4
device='cuda' if torch.cuda.is_available() else "cpu"
eval_iters=50
n_dim=192
n_heads=6
n_layers=6
n_dropout=0.1
print("The device being used is",device)
with open("input.txt","r",encoding="latin1") as file:
  text=file.read()

characters=sorted(list(set(text)))
vocab_size=len(characters)
print("The vocabulary size is",vocab_size)
stoi={ch:i for i,ch in enumerate(characters)}
iots={i:ch for i,ch in enumerate(characters)}

def encode(s):
  return [stoi[c] for c in s]
def decode(ids):
  return "".join(iots[i] for i in ids)
data=torch.tensor(encode(text),dtype=torch.long)
n=int(0.9*len(data))
training_data=data[:n]
val_data=data[n:]


#------------------------------ Defining get_batch and evaluate loss functions -----------------------------------------------------------------------------

def get_batch(split):
  d=training_data if split=="train" else val_data
  ix=torch.randint(len(d)-block_size,(batch_size,))
  x=torch.stack([d[i:i+block_size] for i in ix])
  y=torch.stack([d[i+1:i+block_size+1] for i in ix])
  return x.to(device),y.to(device)
@torch.no_grad()

def estimate_loss(model):
  output={}
  model.eval()
  for split in ("train","eval"):
    losses=torch.zeros(eval_iters)
    for k in range(eval_iters):
      X,Y=get_batch(split)
      _,loss=model(X,Y)
      losses[k]=loss.item()
    output[split]=losses.mean().item()
  model.train()
  return output
# -------------------------------------------------- Model Architecture -----------------------------------------------------------------------------------------------
# crating a single head
class Head(nn.Module):
  def __init__(self,head_size):
    super().__init__()
    self.key=nn.Linear(n_dim,head_size,bias=False)
    self.value=nn.Linear(n_dim,head_size,bias=False)
    self.query=nn.Linear(n_dim,head_size,bias=False)
    self.register_buffer("tril",torch.tril(torch.ones(block_size,block_size)))
    self.dropout=nn.Dropout(n_dropout)
# Designing the attention mechanism
  def forward(self,x):
    b,t,c=x.shape
    k=self.key(x)
    q=self.query(x)
    wei=q@k.transpose(-2,-1)*(c**-0.5)
    wei=wei.masked_fill(self.tril[:t,:t]==0,float("-inf"))
    wei=F.softmax(wei,dim=-1)
    wei=self.dropout(wei)
    v=self.value(x)
    out=wei@v
    return out
    # Creating a system of multi head attention mechanism
class MultiHeadAttention(nn.Module):
  def __init__(self,nheads,head_size):
    super().__init__()
    self.heads=nn.ModuleList([Head(head_size) for _ in range(nheads)])
    self.proj=nn.Linear(n_dim,n_dim)
    self.dropout=nn.Dropout(n_dropout)
  def forward(self,x):
    out=torch.cat([h(x) for h in self.heads],dim=-1)
    out=self.dropout(self.proj(out))
    return out
# Feed forward network increases the dimensions of the input and then applies GELU and then returns them to the original dimensions
class Feedforwardnetwork(nn.Module):
  def __init__(self,n_dims):
    super().__init__()
    self.net=nn.Sequential(nn.Linear(n_dims,n_dims*4)
    ,nn.GELU(),nn.Linear(n_dims*4,n_dims),nn.Dropout(n_dropout))
  def forward(self,x):
    return self.net(x)
# Creating a single transformer block using self attention and ffn with layer normalization
class Block(nn.Module):
  def __init__(self,ndimensions,nheads):
    super().__init__()
    head_size=ndimensions//nheads
    self.sa=MultiHeadAttention(nheads,head_size)
    self.ffn=Feedforwardnetwork(ndimensions)
    self.ln1=nn.LayerNorm(ndimensions)
    self.ln2=nn.LayerNorm(ndimensions)
  def forward(self,x):
    x=x+self.sa(self.ln1(x))
    x=x+self.ffn(self.ln2(x))
    return x
class Mygpt(nn.Module):
  def __init__(self):
    super().__init__()
    self.token_embedding_table=nn.Embedding(vocab_size,n_dim)
    self.posi_embedding_table=nn.Embedding(block_size,n_dim)
    self.blocks=nn.Sequential(*[Block(n_dim,n_heads) for _ in range(n_layers)])
    self.ln_f=nn.LayerNorm(n_dim)
    self.lm=nn.Linear(n_dim,vocab_size)
  def forward(self,idx,targets=None):
    B,T=idx.shape
    tok_emb=self.token_embedding_table(idx)
    posi_emb=self.posi_embedding_table(torch.arange(T,device=device))
    x=tok_emb+posi_emb
    x=self.blocks(x)
    x=self.ln_f(x)
    logits=self.lm(x)
    if targets is None:
      loss=None
    else:
      B,T,C=logits.shape
      logits=logits.view(B*T,C)
      targets=targets.view(B*T)
      loss=F.cross_entropy(logits,targets)
    return logits,loss
#------------------------- Generation of new tokens autoregressively ------------------------------------------------------------------------
  @torch.no_grad()
  def generate(self,idx,max_new):
    for i in range(max_new):
      idx_conti=idx[:,-block_size:]
      logits,i=self(idx_conti)
      logits=logits[:,-1,:]
      probs=F.softmax(logits,dim=-1)
      idx_next=torch.multinomial(probs,num_samples=1)
      idx=torch.concat((idx,idx_next),dim=1)
    return idx
# ------------------------------------------------ Training the model ------------------------------------------------------------------------------------------------

model=Mygpt().to(device)
n_parameters=sum(p.numel() for p in (model.parameters()))
print(f"The model has {n_parameters//1e6:.2f} million parameters ")
optimizer=torch.optim.AdamW(model.parameters(),lr=learning_rate)
for i in range(max_tiers):
  if i%eval_inter==0 or  i==max_tiers-1:
    losses=estimate_loss(model)
    print(f" for step{i} training loss={losses["train"]:.4f}, and validation loss={losses["eval"]:.4f}")
  xb,yb=get_batch("train")
  logits,loss=model(xb,yb)
  optimizer.zero_grad(set_to_none=True)
  loss.backward()
  optimizer.step()
#  ------------- ----------------------- Sample text  generation from the model -----------------------------------------------------------------------------------------

print("\n---------- sample generation")
context=torch.zeros((1,1),dtype=torch.long,device=device)
generated=model.generate(context,max_new=500)
print(decode(generated[0].tolist()))

#----------------------------------------- Save the trained model ---------------------------------------------------------------------

torch.save(model.state_dict(),"Mygpt.pt")

print("Saved the weights to Mygpt.pt")
